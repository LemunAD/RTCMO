# Supabase Auth configuration used by the booking site.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin panel (/admin). Set a strong password and a random session secret.
# Generate a secret with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Required for server-side access to the RLS-protected bookings table.
# Never expose this key to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Apply supabase/sql/03-chaabi-payments.sql before configuring hosted checkout.
# Use the gateway URL and credentials issued for the same merchant environment.
CHAABI_PAYMENTS_ENABLED=false
CHAABI_GATEWAY_URL=https://test-chaabipayment.cmi.co.ma/fim/est3dgate
CHAABI_SITE_URL=
CHAABI_CLIENT_ID=
CHAABI_STORE_KEY=
