# Supabase project used to store bookings (public anon key — used by the
# public booking form and its API routes).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin panel (/admin). Set a strong password and a random session secret.
# Generate a secret with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Optional but recommended: Supabase service role key, used only by the
# admin API routes (server-side) so listing/cancelling reservations works
# even if the anon key's row-level security policies don't allow it.
# Never expose this key to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
